        const gelis = parseFloat(txtGelis);
        const kargo = parseFloat(txtKargo);
        const promosyon = parseFloat(txtPromosyon);
        const kar_yuzde_target = parseFloat(txtKar);

        if (isNaN(gelis) || isNaN(kargo) || isNaN(promosyon) || isNaN(kar_yuzde_target)) {
            alert("Hata: Tüm alanları doğru doldurun!");
            return;
        }

        const newCards = [];
        Object.entries(marketVars).forEach(([mp, selected]) => {
            if (selected) {
                const komisyon = MARKETPLACES[mp];
                const maliyet = gelis + kargo + promosyon;
                let satis = 0;
                if ((100 - komisyon - kar_yuzde_target) !== 0) {
                     satis = maliyet / ((100 - komisyon - kar_yuzde_target) / 100);
                } else {
                    // Avoid division by zero, maybe set satis to maliyet or show an error/warning
                    satis = maliyet; // Or handle as an impossible scenario
                }
                const net_kar = satis - maliyet - (satis * komisyon / 100);
                const kar_orani = maliyet > 0 ? (100 * net_kar / maliyet) : 0;

                newCards.push({
                    pazaryeri: mp,
                    ebat: cmbEbat || "N/A",
                    satis: satis,
                    kar: net_kar,
                    kar_yuzde: kar_orani,
                    komisyon: komisyon,
                    id: mp + (cmbEbat || "") + Date.now() // Basic unique key
