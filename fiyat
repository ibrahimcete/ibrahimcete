            `2. Fiyat Stratejisi: Yukarıdaki verilere ve rekabet analizine göre, bu ürün için optimum satış fiyat aralığı ne olmalı? Fiyatlandırmada dikkat edilmesi gerekenler nelerdir?\n`+
            `3. Reklam ve Promosyon Önerileri: Bu ürünü (yatak kategorisinde olduğunu varsayarak) pazarlamak için en etkili reklam ve promosyon stratejileri nelerdir? (Trendyol, Google Ads, Sosyal Medya odaklı)\n`+
            `4. Düşük Bütçeli Lansman: Yeni çıkan bir yatak ürününü düşük bütçeyle hızlıca üst sıralara taşımak ve görünürlüğünü artırmak için spesifik reklam kanalları, anahtar kelimeler ve taktikler (maddeler halinde).\n`+
            `5. Influencer Marketing: Yatak satışı için hangi tür influencer'larla nasıl işbirlikleri yapılabilir? Beklenen yatırım getirisi (ROI) nasıl maksimize edilir?\n`+
            `Lütfen tüm yanıtları madde madde, net ve pratik önerilerle sunun.`
        );
        setTxtAiIn(prompt);
    }, [cmbModel, cmbEbat, marketVars, txtGelis, txtKargo, txtPromosyon, txtKar]);

    useEffect(() => { // Auto-fill AI panel when Fiyat Hesapla inputs change
        if(activeTab === "AI Strateji") { // Only fill if AI tab is active or becomes active
           fillAiPanelFromFiyat();
        }
    }, [activeTab, fillAiPanelFromFiyat]);


    const getAiSuggestion = async (promptType = "general") => {
        let currentPrompt = txtAiIn.trim();
        if (!currentPrompt && promptType !== "price_suggestion") {
            alert("Uyarı: Lütfen soru veya veri girin!");
            return;
        }
        if (!openAIKey) {
            alert("API Key Gerekli: AI özelliği için Ayarlar sekmesinden OpenAI API anahtarınızı girin.");
            setActiveTab("Ayarlar");
            return;
        }

        if (promptType === "price_suggestion") {
            const baseInfo = `Ürün: ${cmbModel || "Belirtilmemiş Model"}, Ölçü: ${cmbEbat || "Belirtilmemiş Varyant"}, Geliş Fiyatı: ${txtGelis || "N/A"} ₺, Kargo: ${txtKargo || "N/A"} ₺, Promosyon: ${txtPromosyon || "N/A"} ₺.`;
            currentPrompt = `${baseInfo}\n\nMevcut pazar koşulları, rekabet (Türkiye yatak pazarı), ve potansiyel müşteri talebini göz önünde bulundurarak, bu ürün için en yüksek talep ve kârı getirebilecek **optimal satış fiyat aralığını** ve bu fiyatı belirlerken kullanılabilecek **stratejileri** detaylıca analiz edip önerin. Pazaryeri komisyonlarını da (%18-%21 aralığında düşünün) hesaba katın. Yanıtı net rakamlar ve gerekçelerle sunun.`;
            setTxtAiIn(currentPrompt); // Update the input field as well
        }


        setTxtAiOut("Yükleniyor... AI düşünüyor...");
        try {
            // NOTE: This is a client-side call. For production, use a backend proxy.
            const response = await fetch("https://api.openai.com/v1/chat/completions", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${openAIKey}`
                },
                body: JSON.stringify({
                    model: "gpt-3.5-turbo", // or gpt-4 if available and preferred
                    messages: [
                        { role: "system", content: "Bir B2B e-ticaret ve pazarlama stratejisti gibi yanıtla. Rakip fiyatları, pazar rekabetini, satış ipuçlarını ve kısa, uygulanabilir önerileri özellikle belirt. Türkiye pazarına odaklan." },
                        { role: "user", content: currentPrompt }
                    ],
                    max_tokens: 1500, // Increased for potentially more detailed responses
                    temperature: 0.7, // Balances creativity and determinism
                })
            });
            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(`OpenAI API Error: ${response.status} - ${errorData.error?.message || 'Unknown error'}`);
            }
            const data = await response.json();
            if (data.choices && data.choices.length > 0 && data.choices[0].message) {
                setTxtAiOut(data.choices[0].message.content);
            } else {
                setTxtAiOut("Hata: AI'dan geçerli bir yanıt alınamadı.");
            }
        } catch (e) {
            console.error("OpenAI API call failed:", e);
            setTxtAiOut(`Hata: ${e.message}\n\nAPI Anahtarınızı ve internet bağlantınızı kontrol edin. Konsola bakın.`);
        }
    };

    // Excel Export Tab
    const [isExportPopupOpen, setIsExportPopupOpen] = useState(false);
    const [exportMarketVars, setExportMarketVars] = useState(
        Object.keys(MARKETPLACES).reduce((acc, mp) => ({ ...acc, [mp]: true }), {})
    );
    const [exportProductVars, setExportProductVars] = useState(
        Object.keys(productPrices).reduce((acc, model) => ({ ...acc, [model]: true }), {})
    );
    useEffect(() => { // Keep exportProductVars in sync with productPrices
      setExportProductVars(Object.keys(productPrices).reduce((acc, model) => ({...acc, [model]: true }), {}));
    }, [productPrices]);

    const [exportKargo, setExportKargo] = useState("180");
    const [exportPromo, setExportPromo] = useState("50");
    const [exportKar, setExportKar] = useState("20");


    const handleExportToExcel = () => {
        const selectedMarkets = Object.entries(exportMarketVars).filter(([,v]) => v).map(([k]) => k);
        const selectedProducts = Object.entries(exportProductVars).filter(([,v]) => v).map(([k]) => k);

        if (selectedMarkets.length === 0 || selectedProducts.length === 0) {
            alert("Hata: En az bir pazaryeri ve ürün seçmelisiniz!");
            return;
        }
        const kargo = parseFloat(exportKargo);
        const promo = parseFloat(exportPromo);
        const karYuzdeTarget = parseFloat(exportKar);
        if (isNaN(kargo) || isNaN(promo) || isNaN(karYuzdeTarget)) {
            alert("Hata: Kargo/promosyon/kâr değerlerini kontrol edin!");
            return;
        }

        const dataToExport = [];
        selectedProducts.forEach(model => {
            if (productPrices[model]) {
                Object.entries(productPrices[model]).forEach(([ebat, gelis]) => {
                    selectedMarkets.forEach(mp => {
                        const komisyon = MARKETPLACES[mp];
                        const maliyet = gelis + kargo + promo;
                        let satis = 0;
                        if ((100 - komisyon - karYuzdeTarget) !== 0) {
                            satis = maliyet / ((100 - komisyon - karYuzdeTarget) / 100);
                        } else {
                            satis = maliyet; // Avoid division by zero
                        }
                        const netKar = satis - maliyet - (satis * komisyon / 100);
                        const karOrani = maliyet > 0 ? (100 * netKar / maliyet) : 0;
                        dataToExport.push({
                            "Model": model,
                            "Varyant": ebat,
                            "Geliş Fiyatı": gelis,
                            "Kargo": kargo,
                            "Promosyon": promo,
                            "Maliyet": parseFloat(maliyet.toFixed(2)),
                            "Satış Fiyatı (Hedeflenen)": parseFloat(satis.toFixed(2)),
                            "Net Kâr (Hedeflenen)": parseFloat(netKar.toFixed(2)),
                            "Kâr Marjı (%) (Hedeflenen)": parseFloat(karOrani.toFixed(1)),
                            "Pazaryeri Komisyon Oranı (%)": komisyon,
                            "Pazaryeri": mp
                        });
                    });
                });
            }
        });

        if (dataToExport.length === 0) {
            alert("Uyarı: Dışa aktarılacak veri yok!");
            return;
        }

        // Using a library like 'xlsx' (SheetJS) would be ideal here
        // Example with SheetJS (make sure to install it: yarn add xlsx):
        /*
        const worksheet = XLSX.utils.json_to_sheet(dataToExport);
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "FiyatListesi");
        XLSX.writeFile(workbook, "Razzoni_Fiyat_Listesi.xlsx");
        */
        // Fallback to CSV for simplicity if XLSX is not set up:
        const headers = Object.keys(dataToExport[0]);
        const csvContent = "data:text/csv;charset=utf-8,"
            + headers.join(",") + "\n"
            + dataToExport.map(row => headers.map(header => `"${String(row[header]).replace(/"/g, '""')}"`).join(",")).join("\n");

        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "Razzoni_Fiyat_Listesi.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);

        alert("Başarılı: Veri CSV olarak indirildi! (Excel için bir kütüphane entegre edilebilir.)");
        setIsExportPopupOpen(false);
    };


    // Ayarlar Tab
    const [apiKeyInput, setApiKeyInput] = useState(openAIKey);
    const handleSaveApiKey = () => {
        setOpenAIKey(apiKeyInput);
        saveApiKeyToStorage(apiKeyInput);
        alert("Başarılı: API Key kaydedildi.");
    };


    const renderTabContent = () => {
        switch (activeTab) {
            case "Fiyat Hesapla":
                return (
                    <div style={{ display: 'flex', gap: '20px', height: 'calc(100vh - 150px)' }}>
                        <OnboardingInfo
                            message="Fiyat Hesapla Sekmesi: Ürün maliyetlerinizi girip, pazaryerlerine göre satış fiyatı ve kârınızı hesaplayın."
                            storageKey="onboarding_fiyat_hesapla_seen"
                        />
                        <div className="ctk-frame" style={{ width: '300px', flexShrink: 0, overflowY: 'auto' }}>
                            <label className="ctk-label" style={{ fontSize: '16px', fontWeight: 'bold' }}>Ürün Modeli</label>
                            <select className="ctk-combo" value={cmbModel} onChange={e => setCmbModel(e.target.value)}>
                                <option value="">Model Seçin</option>
                                {Object.keys(productPrices).map(model => (
                                    <option key={model} value={model}>{model}</option>
                                ))}
                            </select>

                            <label className="ctk-label" style={{ fontSize: '16px', fontWeight: 'bold' }}>Ölçü (Varyant)</label>
                            <select className="ctk-combo" value={cmbEbat} onChange={e => setCmbEbat(e.target.value)}>
                                <option value="">Ölçü Seçin</option>
                                {cmbModel && productPrices[cmbModel] && Object.keys(productPrices[cmbModel]).map(ebat => (
                                    <option key={ebat} value={ebat}>{ebat}</option>
                                ))}
                            </select>

                            <input className="ctk-entry" type="number" placeholder="Geliş Fiyatı (₺)" value={txtGelis} onChange={e => setTxtGelis(e.target.value)} />
                            <input className="ctk-entry" type="number" placeholder="Kargo Fiyatı (₺)" value={txtKargo} onChange={e => setTxtKargo(e.target.value)} />
                            <input className="ctk-entry" type="number" placeholder="Promosyon Gideri (₺)" value={txtPromosyon} onChange={e => setTxtPromosyon(e.target.value)} />
                            <input className="ctk-entry" type="number" placeholder="Kâr Yüzdesi (%)" value={txtKar} onChange={e => setTxtKar(e.target.value)} />

                            <label className="ctk-label" style={{ fontSize: '15px', fontWeight: 'bold', marginTop: '12px' }}>Pazaryerleri</label>
                            {Object.keys(MARKETPLACES).map(mp => (
                                <div key={mp} style={{ marginBottom: '5px' }}>
                                    <input type="checkbox" id={`chk-${mp}`} checked={marketVars[mp]} onChange={() => handleMarketVarChange(mp)} style={{ marginRight: '8px' }} />
                                    <label htmlFor={`chk-${mp}`}>{mp}</label>
                                </div>
                            ))}
                            <button className="ctk-button ctk-button-primary" onClick={calculatePrices} style={{ marginTop: '15px', width: '100%' }}>HESAPLA</button>
                             {/* Ad/Promo Banner Placeholder */}
                            <div className="ad-banner-placeholder" style={{marginTop: '30px'}}>
                                ✨ Özel Teklif Alanı ✨ <br/> Razzoni Yataklarında %20 İndirim!
                            </div>
                        </div>
                        <div className="fiyat-card-grid" style={{ flexGrow: 1 }}>
                            {calculatedCards.length === 0 && <p>Hesaplama yapmak için soldaki formu doldurun.</p>}
                            {calculatedCards.map((cardData) => (
                                <FiyatCard key={cardData.id} data={cardData} />
                            ))}
                        </div>
                    </div>
                );
            case "Ürünler":
                return (
                    <div>
                        <OnboardingInfo
                            message="Ürünler Sekmesi: Ürünlerinizi ve varyantlarını listeleyin, ekleyin, düzenleyin veya silin."
                            storageKey="onboarding_urunler_seen"
                        />
                        <div className="products-table">
                            {Object.keys(productPrices).length === 0 && <p>Henüz ürün eklenmemiş.</p>}
                            {Object.entries(productPrices).map(([model, ebats]) => (
                                <div key={model}>
                                    <div className="product-model-header">{`Model: ${model}`}</div>
                                    {Object.entries(ebats).map(([ebat, fiyat]) => (
                                        <div key={`${model}-${ebat}`} className="product-variant-item">
                                            {`• ${ebat}   ➔   ${fiyat} ₺`}
                                        </div>
                                    ))}
                                </div>
                            ))}
                        </div>
                        <div className="button-group">
                            <button className="ctk-button ctk-button-success" onClick={() => setIsAddProductPopupOpen(true)}>➕ Yeni Ürün Ekle</button>
                            <button className="ctk-button ctk-button-warning" onClick={handleEditProduct}>✏️ Ürün/Varyant Düzenle</button>
                            <button className="ctk-button ctk-button-danger" onClick={handleDeleteProduct}>🗑️ Ürün/Varyant Sil</button>
                            {/* Save is implicit with state updates to localStorage */}
                        </div>

                        {isAddProductPopupOpen && (
                            <div className="modal-overlay">
                                <div className="modal-content">
                                    <h3>Yeni Ürün Ekle</h3>
                                    <label htmlFor="newModel">Ürün Model Adı:</label>
                                    <input type="text" id="newModel" className="ctk-entry" value={newProductModel} onChange={e => setNewProductModel(e.target.value)} />
                                    <label htmlFor="newEbats">Varyant/Fiyat (örn: 90x190:1780,100x200:2100)</label>
                                    <input type="text" id="newEbats" className="ctk-entry" value={newProductEbats} onChange={e => setNewProductEbats(e.target.value)} />
                                    <div className="modal-buttons">
                                        <button className="ctk-button" onClick={() => setIsAddProductPopupOpen(false)}>İptal</button>
                                        <button className="ctk-button ctk-button-success" onClick={handleAddProduct}>Kaydet</button>
                                    </div>
                                </div>
                            </div>
                        )}
                    </div>
                );
            case "AI Strateji":
                return (
                    <div ref={aiTabContentRef}>
                        <OnboardingInfo
                            message="AI Strateji Sekmesi: Fiyat bilgilerini yükleyip OpenAI'dan pazar, fiyat ve reklam stratejileri hakkında tavsiye alın."
                            storageKey="onboarding_ai_strateji_seen"
                        />
                        <h2 style={{ textAlign: 'center', margin: '20px 0' }}>🤖 AI Destekli Strateji ve Tavsiye Paneli</h2>
                        <textarea
                            className="ctk-textbox"
                            rows="10"
                            value={txtAiIn}
                            onChange={e => setTxtAiIn(e.target.value)}
                            placeholder="AI'ye sormak istediğiniz pazar araştırması, rakip analizi veya strateji sorularını buraya yazın..."
                        />
                        <div style={{ display: 'flex', justifyContent: 'center', gap: '10px', margin: '10px 0' }}>
                            <button className="ctk-button ctk-button-primary" onClick={fillAiPanelFromFiyat}>Fiyat Bilgilerini Otomatik Yükle</button>
                            <button className="ctk-button ctk-button-primary" onClick={() => getAiSuggestion("general")}>Tavsiye Al (OpenAI)</button>
                            <button className="ctk-button ctk-button-success" onClick={() => getAiSuggestion("price_suggestion")}>🎯 En İyi Fiyatı Öner (AI)</button>
                        </div>
                        <textarea
                            className="ctk-textbox"
                            rows="15"
                            value={txtAiOut}
                            readOnly
                            placeholder="AI'dan gelen yanıt burada görünecek..."
                        />
                    </div>
                );
            case "Excel Aktar":
                 return (
                    <div>
                        <OnboardingInfo
                            message="Excel Aktar Sekmesi: Seçtiğiniz ürün ve pazaryerleri için hesaplanmış fiyat listesini dışa aktarın."
                            storageKey="onboarding_excel_aktar_seen"
                        />
                        <h2 style={{ textAlign: 'center', margin: '30px 0' }}>Excel'e Gelişmiş Aktarım</h2>
                        <div style={{ display: 'flex', justifyContent: 'center' }}>
                            <button className="ctk-button ctk-button-primary" style={{padding: '12px 24px', fontSize: '16px'}} onClick={() => setIsExportPopupOpen(true)}>
                                📥 Seçerek Excel/CSV'ye Aktar
                            </button>
                        </div>

                        {isExportPopupOpen && (
                            <div className="modal-overlay">
                                <div className="modal-content" style={{maxWidth: '600px'}}>
                                    <h3>Excel/CSV'ye Aktarım Seçimi</h3>
                                    <div style={{display: 'flex', gap: '20px'}}>
                                        <div style={{flex: 1}}>
                                            <h4>Pazaryeri Seçimi (Çoklu)</h4>
                                            {Object.keys(MARKETPLACES).map(mp => (
                                                <div key={`exp-mp-${mp}`}>
                                                    <input type="checkbox" id={`exp-chk-mp-${mp}`} checked={!!exportMarketVars[mp]} onChange={() => setExportMarketVars(prev => ({...prev, [mp]: !prev[mp]}))} />
                                                    <label htmlFor={`exp-chk-mp-${mp}`}>{mp}</label>
                                                </div>
                                            ))}
                                        </div>
                                        <div style={{flex: 1}}>
                                            <h4>Ürün Modelleri (Çoklu)</h4>
                                            {Object.keys(productPrices).map(model => (
                                                <div key={`exp-prod-${model}`}>
                                                    <input type="checkbox" id={`exp-chk-prod-${model}`} checked={!!exportProductVars[model]} onChange={() => setExportProductVars(prev => ({...prev, [model]: !prev[model]}))} />
                                                    <label htmlFor={`exp-chk-prod-${model}`}>{model}</label>
                                                </div>
                                            ))}
                                             {Object.keys(productPrices).length === 0 && <p>Aktarılacak ürün yok. Lütfen önce ürün ekleyin.</p>}
                                        </div>
                                    </div>
                                    <hr style={{margin: '20px 0', borderColor: '#30363d'}}/>
                                    <div>
                                        <label>Kargo Fiyatı (₺) (her ürün için):</label>
                                        <input className="ctk-entry" type="number" value={exportKargo} onChange={e => setExportKargo(e.target.value)} />
                                        <label>Promosyon Gideri (₺):</label>
                                        <input className="ctk-entry" type="number" value={exportPromo} onChange={e => setExportPromo(e.target.value)} />
                                        <label>Kâr Yüzdesi (%):</label>
                                        <input className="ctk-entry" type="number" value={exportKar} onChange={e => setExportKar(e.target.value)} />
                                    </div>
                                    <div className="modal-buttons">
                                        <button className="ctk-button" onClick={() => setIsExportPopupOpen(false)}>İptal</button>
                                        <button className="ctk-button ctk-button-success" onClick={handleExportToExcel}>Aktar</button>
                                    </div>
                                </div>
                            </div>
                        )}
                    </div>
                );
            case "Geçmiş":
                return (
                     <div>
                        <OnboardingInfo
                            message="Geçmiş Sekmesi: Bu alan gelecekteki geliştirmeler için planlanmıştır (örn: kaydedilmiş hesaplamalar, AI sorguları)."
                            storageKey="onboarding_gecmis_seen"
                        />
                        <h2 style={{ textAlign: 'center', margin: '30px 0' }}>🕓 Geçmiş – Son Teklifler (Geliştirilecek)</h2>
                        <p style={{textAlign: 'center'}}>Bu özellik yakında eklenecektir. Kaydedilmiş hesaplamalarınızı ve AI analizlerinizi burada bulabileceksiniz.</p>
                    </div>
                );
            case "Ayarlar":
                return (
                     <div>
                        <OnboardingInfo
                            message="Ayarlar Sekmesi: OpenAI API anahtarınızı kaydedin ve uygulama temasını değiştirin."
                            storageKey="onboarding_ayarlar_seen"
                        />
                        <h2 style={{ textAlign: 'center', margin: '20px 0' }}>⚙️ Ayarlar</h2>
                        <div style={{ maxWidth: '500px', margin: '0 auto' }}>
                            <label className="ctk-label" style={{fontSize: '15px'}}>OpenAI API Key:</label>
                            <input
                                type="password"
                                className="ctk-entry"
                                value={apiKeyInput}
                                onChange={e => setApiKeyInput(e.target.value)}
                                placeholder="OpenAI API Anahtarınızı buraya girin"
                            />
                            <button className="ctk-button ctk-button-primary" onClick={handleSaveApiKey} style={{marginTop: '5px'}}>Kaydet</button>

                            <label className="ctk-label" style={{fontSize: '15px', marginTop: '30px'}}>Tema:</label>
                            <button className="ctk-button" onClick={toggleTheme} style={{backgroundColor: theme === 'Dark' ? '#58a6ff' : '#6e7681', color: 'white'}}>
                                {theme === 'Dark' ? 'Açık Mod' : 'Gece Modu'} Kullan
                            </button>
                        </div>
                    </div>
                );
            default:
                return null;
        }
    };

    const tabs = ["Fiyat Hesapla", "Ürünler", "AI Strateji", "Excel Aktar", "Geçmiş", "Ayarlar"];

    return (
        <>
            <style>{styles}</style>
            <div className="app-container" style={{ backgroundColor: theme === 'Dark' ? '#0d1117' : '#f0f0f0', color: theme === 'Dark' ? '#c9d1d9' : '#24292e' }}>
                <h1 style={{ textAlign: 'center', color: theme === 'Dark' ? '#58a6ff' : '#0366d6', margin: '10px 0 15px 0' }}>
                    🛏️ Razzoni Ultra Gelişmiş Fiyat Paneli (React Version)
                </h1>
                <nav className="tabs-nav" style={{backgroundColor: theme === 'Dark' ? '#161b22' : '#f6f8fa', borderColor: theme === 'Dark' ? '#30363d' : '#e1e4e8'}}>
                    {tabs.map(tabName => (
                        <button
                            key={tabName}
                            className={`tab-button ${activeTab === tabName ? 'active' : ''}`}
                            onClick={() => setActiveTab(tabName)}
                            style={activeTab === tabName ?
                                {backgroundColor: theme === 'Dark' ? '#238636' : '#0366d6', color: 'white'} :
                                {color: theme === 'Dark' ? '#8b949e' : '#586069', backgroundColor: 'transparent'}
                            }
                        >
                            {tabName}
                        </button>
                    ))}
                </nav>
                <main className="tab-content" style={{backgroundColor: theme === 'Dark' ? '#161b22' : '#ffffff', color: theme === 'Dark' ? '#c9d1d9' : '#24292e'}}>
                    {renderTabContent()}
                </main>
            </div>

            {/* Welcome Tour Modal */}
            {showWelcomeTour && welcomeTourSteps[currentTourStep] && (
                <div className="modal-overlay">
                    <div className="modal-content" style={{textAlign: 'center'}}>
                        <h3>{welcomeTourSteps[currentTourStep].title}</h3>
                        <p>{welcomeTourSteps[currentTourStep].text}</p>
                        <button className="ctk-button ctk-button-primary" onClick={handleNextTourStep}>
                            {currentTourStep === welcomeTourSteps.length - 1 ? "Bitir" : "Sonraki"}
                        </button>
                    </div>
                </div>
            )}
        </>
    );
}

export default App;
